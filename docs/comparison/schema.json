{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omniswitch-dev/omniswitch/blob/main/docs/comparison/schema.json",
  "title": "OmniSwitch capability claims register (version 1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gateways", "capabilities", "claims"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_note": {"type": "string"},
    "gateways": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "tier"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"type": "string", "minLength": 1},
          "tier": {"enum": ["harness", "harness-deferred", "managed"]}
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"type": "string", "minLength": 1}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "gateway", "status", "detail", "source_url", "verified_on", "version"],
      "properties": {
        "capability": {"$ref": "#/$defs/id"},
        "gateway": {"$ref": "#/$defs/id"},
        "status": {"enum": ["yes", "partial", "no", "unknown"]},
        "qualifier": {
          "description": "Optional maturity, edition, or licensing boundary; omit when not applicable.",
          "enum": ["beta", "enterprise", "license"]
        },
        "detail": {"type": "string", "minLength": 1},
        "source_url": {"type": "string"},
        "verified_on": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "version": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["yes", "partial", "no"]}}},
          "then": {"properties": {"source_url": {"minLength": 1}}}
        }
      ]
    }
  }
}
