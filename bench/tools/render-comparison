#!/usr/bin/env python3
"""Render docs/comparison/claims.yaml into docs/comparison/COMPARISON.md.

Usage:
    bench/tools/render-comparison [--claims PATH] [--out PATH] [--check]

--check exits non-zero if the rendered output would differ from what is
currently committed, without writing anything. Use it in CI to catch a
claims.yaml edit that was not followed by a re-render.

This script has no third-party dependencies beyond PyYAML, which is commonly
available; if PyYAML is missing it falls back to a small embedded YAML
subset parser sufficient for this file's shape (flat scalars, lists of flat
maps, no anchors/tags). The fallback exists so CI/dev boxes without PyYAML
pre-installed can still render the register.
"""
from __future__ import annotations

import argparse
import datetime
import json
import re
import os
import sys

STATUS_LABEL = {
    "yes": "Yes",
    "partial": "Partial",
    "no": "No",
    "unknown": "Unknown",
}

QUALIFIERS = {"beta", "enterprise", "license"}


def load_yaml(path: str):
    try:
        import yaml  # type: ignore

        with open(path, "r", encoding="utf-8") as f:
            return yaml.safe_load(f)
    except ImportError:
        return _load_yaml_fallback(path)


def _load_yaml_fallback(path: str):
    """Read the register's flat maps, including folded scalar continuations.

    This is not a general YAML parser. The hand-authored register uses plain,
    single-quoted or JSON-compatible double-quoted scalars, never YAML tags,
    anchors, block scalars or nested claim objects.
    """
    with open(path, "r", encoding="utf-8") as f:
        lines = [line.rstrip("\n") for line in f if not line.lstrip().startswith("#")]
    doc: dict = {"gateways": [], "capabilities": [], "claims": []}
    section = None
    current = None
    target = doc
    last_key = None
    last_indent = 0
    for line in lines:
        if not line.strip():
            continue
        indent = len(line) - len(line.lstrip())
        if indent == 0 and not line.startswith("- "):
            key, value = line.split(":", 1)
            if current is not None:
                doc[section].append(current)
                current = None
            if key in ("gateways", "capabilities", "claims") and not value.strip():
                section = key
                last_key = None
                continue
            section = None
            target = doc
        elif line.startswith("- "):
            if section is None:
                raise ValueError("list outside a register section")
            if current is not None:
                doc[section].append(current)
            current = {}
            target = current
            key, value = line[2:].split(":", 1)
            indent = 2
        elif indent == 2 and section is not None and ":" in line:
            key, value = line.strip().split(":", 1)
        elif last_key is not None and indent > last_indent:
            target[last_key] += " " + line.strip()
            continue
        else:
            raise ValueError(f"unsupported register YAML: {line}")
        last_key = key.strip()
        last_indent = indent
        target[last_key] = value.strip()
    if current is not None:
        doc[section].append(current)

    def scalar(value):
        if len(value) >= 2 and value[0] == value[-1] == "'":
            return value[1:-1].replace("''", "'")
        if len(value) >= 2 and value[0] == value[-1] == '"':
            return json.loads(value)
        return value

    for key, value in doc.items():
        if isinstance(value, str):
            doc[key] = scalar(value)
        elif isinstance(value, list):
            for row in value:
                for row_key, row_value in row.items():
                    row[row_key] = scalar(row_value)
    doc["schema_version"] = int(doc.get("schema_version", 0))
    return doc


def validate(doc: dict) -> None:
    """Enforce the version-1 schema without an extra runtime dependency."""
    if not isinstance(doc, dict) or doc.get("schema_version") != 1:
        raise ValueError("schema_version must be 1")
    if set(doc) - {"schema_version", "generated_note", "gateways", "capabilities", "claims"}:
        raise ValueError("unknown register field")
    if "generated_note" in doc and not isinstance(doc["generated_note"], str):
        raise ValueError("generated_note must be a string")
    ids = {}
    for section, required in (("gateways", {"id", "name", "tier"}), ("capabilities", {"id", "name"})):
        rows = doc.get(section)
        if not isinstance(rows, list) or not rows:
            raise ValueError(f"{section} must be a nonempty list")
        ids[section] = set()
        for row in rows:
            if set(row) != required or any(not isinstance(row[key], str) or not row[key] for key in required):
                raise ValueError(f"invalid {section} row: {row}")
            if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", row["id"]) or row["id"] in ids[section]:
                raise ValueError(f"invalid or duplicate {section} id: {row['id']}")
            ids[section].add(row["id"])
            if section == "gateways" and row["tier"] not in {"harness", "harness-deferred", "managed"}:
                raise ValueError(f"invalid gateway tier: {row['tier']}")
    claims = doc.get("claims")
    if not isinstance(claims, list):
        raise ValueError("claims must be a list")
    seen = set()
    required = {"capability", "gateway", "status", "detail", "source_url", "verified_on", "version"}
    for claim in claims:
        if not required <= set(claim) or set(claim) - required - {"qualifier"}:
            raise ValueError(f"invalid claim fields: {claim}")
        if any(not isinstance(claim[key], str) for key in required):
            raise ValueError("claim fields must be strings")
        if claim["gateway"] not in ids["gateways"] or claim["capability"] not in ids["capabilities"]:
            raise ValueError(f"claim refers to an unknown id: {claim}")
        pair = (claim["gateway"], claim["capability"])
        if pair in seen:
            raise ValueError(f"duplicate claim: {pair}")
        seen.add(pair)
        if claim["status"] not in STATUS_LABEL:
            raise ValueError(f"invalid claim status: {claim['status']}")
        if "qualifier" in claim and (not isinstance(claim["qualifier"], str) or claim["qualifier"] not in QUALIFIERS):
            raise ValueError(f"invalid claim qualifier: {claim['qualifier']}")
        if not claim["detail"] or not claim["version"]:
            raise ValueError(f"claim needs detail and version: {pair}")
        if claim["status"] != "unknown" and not claim["source_url"]:
            raise ValueError(f"confirmed claim needs a source: {pair}")
        if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", claim["verified_on"]):
            raise ValueError(f"invalid verified_on date: {pair}")
        datetime.date.fromisoformat(claim["verified_on"])


def render(doc: dict) -> str:
    validate(doc)
    gateways = doc["gateways"]
    capabilities = doc["capabilities"]
    claims = doc["claims"]

    by_cap_gw = {}
    verified_dates = set()
    for c in claims:
        by_cap_gw[(c["capability"], c["gateway"])] = c
        if c.get("verified_on"):
            verified_dates.add(c["verified_on"])

    harness_gws = [g for g in gateways if g["tier"] in ("harness", "harness-deferred")]
    managed_gws = [g for g in gateways if g["tier"] == "managed"]

    lines = []
    lines.append("<!-- GENERATED FILE. Do not hand-edit. Run `bench/tools/render-comparison` -->")
    lines.append("<!-- after any change to docs/comparison/claims.yaml. -->")
    lines.append("")
    lines.append("# OmniSwitch Competitive Comparison")
    lines.append("")
    lines.append(
        "This table is rendered from `docs/comparison/claims.yaml`, the single "
        "source of truth for every capability claim OmniSwitch makes about "
        "itself or a competitor. See `docs/comparison/README.md` for the "
        "review process. Do not edit this file by hand."
    )
    lines.append("")
    if verified_dates:
        lines.append(f"Most recent row verification: {max(verified_dates)} (individual dates below).")
        lines.append("")
    lines.append(
        "Status legend: **Yes** = confirmed capability, **Partial** = "
        "capability exists with meaningful gaps or scope limits (see Detail), "
        "**No** = confirmed absent, **Unknown** = not independently verified "
        "in available sources (never treated as a claim of absence). "
        "Qualifiers: **beta** = maturity boundary, **enterprise** = edition "
        "boundary, **license** = licensing boundary; see Detail for scope."
    )
    lines.append("")

    def render_section(title: str, gws: list, intro: str = ""):
        lines.append(f"## {title}")
        lines.append("")
        if intro:
            lines.append(intro)
            lines.append("")
        for g in gws:
            lines.append(f"### {g['name']} (`{g['id']}`)")
            lines.append("")
            lines.append("| Capability | Status | Qualifier | Detail | Source | Verified on | Version |")
            lines.append("| --- | --- | --- | --- | --- | --- | --- |")
            for cap in capabilities:
                c = by_cap_gw.get((cap["id"], g["id"]))
                if not c:
                    continue
                status = STATUS_LABEL.get(c["status"], c["status"])
                detail = (c.get("detail") or "").replace("|", "\\|").replace("\n", " ")
                src = c.get("source_url") or ""
                if src:
                    src_cell = f"[link]({src})" if src.startswith("http") else f"`{src}`"
                else:
                    src_cell = ""
                version = (c.get("version") or "").replace("|", "\\|")
                lines.append(
                    f"| {cap['name']} | {status} | {c.get('qualifier', '')} | {detail} | {src_cell} | {c['verified_on']} | {version} |"
                )
            lines.append("")

    render_section(
        "In-harness gateways",
        harness_gws,
        "Gateway products tracked by the self-hosted harness under `bench/`. "
        "A row verified against newer product docs or qualified Enterprise features "
        "is not a result for the pinned OSS benchmark cell. "
        "`envoy-ai-gateway` / Agent Router is Kubernetes-native and deferred "
        "from the loopback harness (see `bench/README.md`).",
    )
    render_section(
        "Managed tier",
        managed_gws,
        "Hosted service editions, mapped by capability rather than run in the "
        "same-host latency harness. See self-hosted rows for product/edition "
        "boundaries.",
    )

    lines.append("## How to regenerate")
    lines.append("")
    lines.append("```")
    lines.append("python3 bench/tools/render-comparison")
    lines.append("```")
    lines.append("")
    return "\n".join(lines) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    here = os.path.dirname(os.path.abspath(__file__))
    repo_root = os.path.abspath(os.path.join(here, "..", ".."))
    parser.add_argument(
        "--claims",
        default=os.path.join(repo_root, "docs", "comparison", "claims.yaml"),
    )
    parser.add_argument(
        "--out",
        default=os.path.join(repo_root, "docs", "comparison", "COMPARISON.md"),
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="Do not write; exit 1 if output would differ from --out.",
    )
    args = parser.parse_args()

    try:
        doc = load_yaml(args.claims)
        rendered = render(doc)
    except (ValueError, KeyError, TypeError) as exc:
        sys.stderr.write(f"invalid claims register: {exc}\n")
        return 2

    if args.check:
        try:
            with open(args.out, "r", encoding="utf-8") as f:
                current = f.read()
        except FileNotFoundError:
            current = ""
        if current != rendered:
            sys.stderr.write(
                f"{args.out} is out of date with {args.claims}; "
                "run bench/tools/render-comparison\n"
            )
            return 1
        return 0

    with open(args.out, "w", encoding="utf-8") as f:
        f.write(rendered)
    print(f"wrote {args.out}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
